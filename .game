# vim: set filetype=game:
# game: this repository
#
# name says which project this is. your game config,
# ~/.config/game/config, has a block for it that says where its road and
# dist are. this file never names a remote; with no block, game builds
# here and pushes nowhere.
#
# game's dist is janearc/game rather than a -dist, because game recognize game.
name game

# the members game is built with, in build order, and the branch each is
# taken at: puzzlemouth, what every tool is built on; libninja and okapi,
# which game's lint is to call. game build stack --from road builds them
# from their roads; game release stack lays them beside game with a
# go.work.
stack puzzlemouth main
stack libninja main
stack okapi main

# lint rules for this repository. any lint line in a .game replaces all
# the lint rules in your game config, so these lines copy all of them.
# the last line is the one change: README.md may run past 25 lines of
# prose.
lint width 80
lint rows 25
lint comments
lint print
lint exclaim
lint shout
lint words hyperscaler enterprise-grade blazing-fast load-bearing
lint paragraph 4
lint allow README.md rows exclaim
# her getting-started doc is written as she talks, and it says so.
lint allow doc/getting-started.md paragraph exclaim words

# property tests, in the packages whose tests import rapid, run under
# game check with this many checks each.
rapid checks 1000
target mocks . :: go run go.uber.org/mock/mockgen@v0.6.0 -destination internal/patch/paths_mock_test.go -package patch_test github.com/janearc/game/internal/patch Paths
target mocks . :: go run go.uber.org/mock/mockgen@v0.6.0 -destination internal/mutants/files_mock_test.go -package mutants_test github.com/janearc/game/internal/mutants Files
target mocks . :: go run go.uber.org/mock/mockgen@v0.6.0 -destination internal/release/temp_files_mock_test.go -package release_test github.com/janearc/game/internal/release TempFiles,PatchFile
target mocks . :: go run go.uber.org/mock/mockgen@v0.6.0 -destination internal/repo/runner_mock_test.go -package repo_test github.com/janearc/game/internal/repo Runner
