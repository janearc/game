# how game is kept, for every editor that reads an .editorconfig.
root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8

# go: real tabs, as gofmt writes them, shown eight wide, which is how
# game's own width rule counts them.
[*.go]
indent_style = tab
tab_width = 8

# everything read as text: two spaces.
[*.{md,yaml,yml,json}]
indent_style = space
indent_size = 2
