# game: a builder's own config, read when GAME_HOME is their home.
# the lint rules are copied from the owner's so both lint the same way.
author someone
exclude spec-docs/
lint width 80
lint rows 25
lint comments
lint print
lint exclaim
lint shout
lint words hyperscaler enterprise-grade blazing-fast load-bearing
lint paragraph 4

project lamb
	road ~/roots/lamb-road.git

project libtheme-css
	road ~/roots/libtheme-css-road.git
	# public already, with history; the tag on github is the dist. the
	# push is the owner's.
	dist https://example.invalid/libtheme-css.git

project libreadme
	road ~/roots/libreadme-road.git
	# public already, with history; the tag on github is the dist. the
	# push is the owner's.
	dist https://example.invalid/libreadme.git

# libreadme as the owner's config names it, so a stack that names readme
# builds here as it does for them.
project readme
	road ~/roots/libreadme-road.git

project game
	road ~/roots/game-road.git

# roads for the trees in a working directory. no dist: releases are the
# owner's, from their checkout and their config.
project libninja
	road ~/roots/libninja.git
project puzzlemouth
	road ~/roots/puzzlemouth-road.git
project tapirworm
	road ~/roots/tapirworm-road.git
project narwhal
	road ~/roots/narwhal-road.git
project okapi
	road ~/roots/okapi-road.git
project burning-trousers
	road ~/roots/burning-trousers.git
project slayer
	road ~/roots/slayer.git
	set SLAYER_SHELF /srv/shelf/sources
project ninjafilm
	road ~/roots/ninjafilm.git
# the light and the geometry below slayer and ninjafilm; the module name
# is a placeholder.
project maths
	road ~/roots/maths.git
project libholemath
	road ~/roots/libholemath-road.git
project stackler
	road ~/roots/stackler.git
project lamb-debacle
	road ~/roots/lamb-debacle.git
project keel
	road ~/roots/keel-road.git
# a third party's tool, held at the tags a project pins; read-only from
# upstream, never pushed to.
project crush
	road ~/roots/crush.git
project lipgloss
	road ~/roots/lipgloss.git
project bubbletea
	road ~/roots/bubbletea.git
project bubbles
	road ~/roots/bubbles.git
project glamour
	road ~/roots/glamour.git
project ultraviolet
	road ~/roots/ultraviolet.git
project x
	road ~/roots/x.git
project crush-fancy
	road ~/roots/crush-fancy.git

# a project back with the builder; no dist: releases are the owner's.
project paratune
	road ~/roots/paratune.git
