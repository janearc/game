author: "someone"
words: ""
license: ""
exclude: ["spec-docs/" "DESIGN.md" "NOTICE" "CHANGELOG.md"]
omit: []
patches: []
theirs: []
rapid: "0"
cover floor: "0"
cover allowed: []
set: []
road: ["bubbles=/srv/ada/roots/bubbles.git" "bubbletea=/srv/ada/roots/bubbletea.git" "burning-trousers=/srv/ada/roots/burning-trousers.git" "crush=/srv/ada/roots/crush.git" "crush-fancy=/srv/ada/roots/crush-fancy.git" "game=/srv/ada/roots/game-road.git" "glamour=/srv/ada/roots/glamour.git" "keel=/srv/ada/roots/keel-road.git" "lamb=/srv/ada/roots/lamb-road.git" "lamb-debacle=/srv/ada/roots/lamb-debacle.git" "libholemath=/srv/ada/roots/libholemath-road.git" "libninja=/srv/ada/roots/libninja.git" "libreadme=/srv/ada/roots/libreadme-road.git" "libtheme-css=/srv/ada/roots/libtheme-css-road.git" "lipgloss=/srv/ada/roots/lipgloss.git" "maths=/srv/ada/roots/maths.git" "narwhal=/srv/ada/roots/narwhal-road.git" "ninjafilm=/srv/ada/roots/ninjafilm.git" "okapi=/srv/ada/roots/okapi-road.git" "paratune=/srv/ada/roots/paratune.git" "puzzlemouth=/srv/ada/roots/puzzlemouth-road.git" "readme=/srv/ada/roots/libreadme-road.git" "slayer=/srv/ada/roots/slayer.git" "stackler=/srv/ada/roots/stackler.git" "tapirworm=/srv/ada/roots/tapirworm-road.git" "ultraviolet=/srv/ada/roots/ultraviolet.git" "x=/srv/ada/roots/x.git"]
dist: ["libreadme=https://example.invalid/libreadme.git" "libtheme-css=https://example.invalid/libtheme-css.git"]
lint: ["width" "80"]
lint: ["rows" "25"]
lint: ["comments"]
lint: ["print"]
lint: ["exclaim"]
lint: ["shout"]
lint: ["words" "hyperscaler" "enterprise-grade" "blazing-fast" "load-bearing"]
lint: ["paragraph" "4"]
lint: ["width" "80"]
lint: ["rows" "25"]
lint: ["comments"]
lint: ["print"]
lint: ["exclaim"]
lint: ["shout"]
lint: ["words" "hyperscaler" "enterprise-grade" "blazing-fast" "load-bearing"]
lint: ["paragraph" "4"]
lint: ["allow" "README.md" "rows"]
run: ["known" "." "go" "run" "./cmd/libtheme" "known"]
run: ["known" "." "go" "run" "./cmd/libtheme" "known" "--paint"]
run: ["known" "." "go" "run" "./cmd/libtheme" "roundtrip"]
run: ["visualdocs" "." "go" "run" "./cmd/visualdocs"]
run: ["visualdocs-css" "." "go" "run" "./cmd/visualdocs" "--css"]
run: ["visualdocs-go" "." "go" "run" "./cmd/visualdocs" "--go"]
run: ["mocks" "." "go" "tool" "mockgen" "-write_package_comment=false" "-destination" "internal/mocks/host.go" "-package" "mocks" "github.com/janearc/libtheme-css/internal/host" "Files,File,Stopper"]
