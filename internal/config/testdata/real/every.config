# a dotfile that says every key the dotfile may say, in each form a line
# may take.
author "Ada Byron"
license ~/licenses/apache.txt
words = ~/lists/sweep.words
exclude spec-docs/
exclude 'internal/bridge/'
omit scratch/
cover 80
rapid checks 50
set CONTACT ada@example.com
set TOKEN two words here
lint width 80
lint rows 25
lint comments
lint words foo bar
lint allow README.md rows
target ghostty . :: sh tools/toolchain
target ghostty ~/src/g :: ~/zig build -Doptimize=ReleaseFast
run ghostty . :: open -na build/app/T.app --args -e bin/daffy

project alpha
	road ~/roots/alpha-road.git
	dist "https://example.invalid/alpha.git"
	set CONTACT alpha@example.com
	# a comment inside the block
	set REGION eu

project beta
    road ../beta.git

project alpha
	set EXTRA more
