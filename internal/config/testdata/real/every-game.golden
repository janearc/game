author: "Ada"
words: ""
license: ""
exclude: ["vendor/"]
omit: ["dist/"]
patches: ["shared/patches" "other/patches"]
theirs: ["crush"]
rapid: "1000"
cover floor: "90"
cover allowed: ["cmd/thing/main.go=needs a real terminal"]
set: []
road: []
dist: []
stack: ["puzzlemouth" "main"]
stack: ["crush" "v0.98.1"]
lint: ["width" "72"]
lint: ["allow" "a.md" "width"]
lint: ["allow" "b.md" "rows" "paragraph"]
needs: ["CONTACT" "a name and email the providers can reach"]
needs: ["REGION" "where it runs"]
run: ["known" "." "go" "run" "./cmd/thing" "known"]
target: ["mocks" "." "go" "run" "example.invalid/mockgen" "-destination" "x.go"]
target: ["mocks" "/srv/ada/there" "/srv/ada/bin/step" "two"]
target: ["quick" "" "go" "build"]
sweep: ["README.md" "emails" "author" "word"]
